{
    "name": "@chenhufei/link-submit-next-widget",
    "version": "1.2.3",
    "description": "Halo 官方 PluginLinks 的友链自助提交增强 Widget",
    "license": "GPL-3.0-only",
    "homepage": "https://github.com/chenhufei/plugin-link-submit-next",
    "repository": {
        "type": "git",
        "url": "https://github.com/chenhufei/plugin-link-submit-next.git",
        "directory": "packages/link-submit-widget"
    },
    "bugs": {
        "url": "https://github.com/chenhufei/plugin-link-submit-next/issues"
    },
    "author": {
        "name": "chenhufei",
        "url": "https://github.com/chenhufei"
    },
    "contributors": [
        {
            "name": "困困鱼",
            "url": "https://github.com/chengzhongxue"
        },
        {
            "name": "柳意梧情",
            "url": "https://github.com/liuyiwuqing"
        }
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/link-submit-widget.js"
        },
        "./var.css": "./var.css"
    },
    "main": "./dist/link-submit-widget.js",
    "module": "./dist/link-submit-widget.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "var.css"
    ],
    "scripts": {
        "dev": "vite --config vite.config.dev.ts",
        "build": "vite build --config vite.config.lib.ts",
        "lint": "lit-analyzer --rules.no-invalid-css off && eslint \"src/**/*.ts\"",
        "prettier": "prettier \"**/*.{cjs,html,js,json,md,ts}\" --ignore-path ./.gitignore --write",
        "test": "vitest",
        "test:ci": "vitest --run"
    },
    "dependencies": {
        "lit": "^3.1.3"
    },
    "pnpm": {
        "onlyBuiltDependencies": ["esbuild"]
    },
    "devDependencies": {
        "@rushstack/eslint-patch": "^1.7.2",
        "@types/node": "20",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^6.21.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.3",
        "lit-analyzer": "^2.0.3",
        "prettier": "^3.3.0",
        "typescript": "^5.4.5",
        "vite": "^8.2.1",
        "vite-plugin-dts": "^5.0.3",
        "vite-plugin-static-copy": "^4.1.1",
        "vitest": "^4.1.11"
    }
